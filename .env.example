DOCMIND_OLLAMA_HOST=http://localhost:11434
DOCMIND_EMBED_MODEL=nomic-embed-text
DOCMIND_LLM_MODEL=qwen3:8b
DOCMIND_CHUNK_SIZE=800
DOCMIND_CHUNK_OVERLAP=120
DOCMIND_TOP_K=4
DOCMIND_MIN_SCORE=0.5
DOCMIND_TEMPERATURE=0.2
DOCMIND_TOP_P=0.9
DOCMIND_REPEAT_PENALTY=1.2
DOCMIND_NUM_PREDICT=512
# Disable reasoning/"thinking" mode on models like qwen3 (faster, better grounding).
DOCMIND_THINK=false
# Embedding task prefixes. Blank = auto (nomic uses search_query/search_document, others none).
# DOCMIND_QUERY_PREFIX=search_query:
# DOCMIND_DOC_PREFIX=search_document:
DOCMIND_INDEX_DIR=index
# Egress guard: only loopback/private/single-label hosts (e.g. localhost, an
# ollama container name) are allowed. Set to false only if you trust a remote host.
DOCMIND_LOCAL_ONLY=true
